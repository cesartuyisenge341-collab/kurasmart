# KuraSmart Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kurasmart
DB_USER=kurasmart_user
DB_PASSWORD=your_secure_password_here

# API Configuration
API_URL=http://localhost/kurasmart/api
API_DOMAIN=localhost
API_PORT=80

# Security - Generate a random string at least 32 characters long
JWT_SECRET=change_this_to_a_random_secret_string_at_least_32_chars
JWT_EXPIRE=3600
JWT_REFRESH_EXPIRE=604800

# Email Configuration (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@kurasmart.com
MAIL_FROM_NAME=KuraSmart

# SMS Configuration (Optional)
SMS_PROVIDER=disabled
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Firebase Cloud Messaging (Optional)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# Application
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=debug

# Timezone
APP_TIMEZONE=Africa/Kigali
