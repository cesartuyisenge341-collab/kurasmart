rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // File size limits
    function isSmallFile() {
      return request.resource.size < 5 * 1024 * 1024; // 5 MB
    }
    
    function isImageFile() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)');
    }
    
    function isPDFFile() {
      return request.resource.contentType == 'application/pdf';
    }
    
    function isCSVFile() {
      return request.resource.contentType == 'text/csv';
    }

    // ============================================================================
    // USER PHOTOS
    // ============================================================================
    
    match /users/{userId}/photo/{allPaths=**} {
      // User can read/write their own photos
      allow read: if isSignedIn();
      allow write: if isUser(userId) && isImageFile() && isSmallFile();
      
      // Allow 200x200 and 500x500 thumbnails
      allow write: if isUser(userId) && 
                      request.resource.name.matches('.*_(200x200|500x500)\\.png') &&
                      isSmallFile();
    }

    // ============================================================================
    // CHILD PHOTOS
    // ============================================================================
    
    match /children/{childId}/photo/{allPaths=**} {
      // Parent can read/write child photos
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageFile() && isSmallFile();
    }

    // ============================================================================
    // GROWTH CHART EXPORTS
    // ============================================================================
    
    match /children/{childId}/reports/growth_{date}.pdf {
      // Parent/caregiver can read
      allow read: if isSignedIn();
      
      // Cloud Functions can write
      allow write: if request.auth.token.claims.role == 'cloud_function' &&
                      isPDFFile() &&
                      request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    match /children/{childId}/reports/sensor_data_{date}.csv {
      // Parent/caregiver can read
      allow read: if isSignedIn();
      
      // Cloud Functions can write
      allow write: if request.auth.token.claims.role == 'cloud_function' &&
                      isCSVFile() &&
                      request.resource.size < 50 * 1024 * 1024; // 50 MB
    }

    // ============================================================================
    // ALERT SNAPSHOTS (For historical reference)
    // ============================================================================
    
    match /children/{childId}/alert_snapshots/{alertId}/{allPaths=**} {
      // Read: Parent/caregiver
      allow read: if isSignedIn();
      
      // Write: Cloud Functions only
      allow write: if request.auth.token.claims.role == 'cloud_function' &&
                      isImageFile() &&
                      request.resource.size < 5 * 1024 * 1024;
    }

    // ============================================================================
    // DEVICE LOGS & DIAGNOSTICS (Admin access)
    // ============================================================================
    
    match /admin/device_logs/{allPaths=**} {
      // Read/write: Cloud Functions and admin only
      allow read, write: if request.auth.token.claims.role == 'cloud_function' ||
                            request.auth.token.claims.role == 'admin';
    }

    // ============================================================================
    // TEMPORARY UPLOADS (Auto-cleanup after 1 day)
    // ============================================================================
    
    match /temp/uploads/{userId}/{filename} {
      // User can write to temp folder
      allow write: if isUser(userId) && 
                      isImageFile() &&
                      isSmallFile();
      
      // Delete after 1 day handled by Cloud Storage lifecycle policy
    }

    // ============================================================================
    // DATA EXPORTS & BACKUPS
    // ============================================================================
    
    match /backups/{userId}/data_export_{date}.json {
      // User can read their own exports
      allow read: if isUser(userId);
      
      // Cloud Functions can write
      allow write: if request.auth.token.claims.role == 'cloud_function' &&
                      request.resource.contentType == 'application/json' &&
                      request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    // ============================================================================
    // PUBLIC ASSETS (Read-only)
    // ============================================================================
    
    match /public/assets/{allPaths=**} {
      allow read: if true; // Public assets
      allow write: if request.auth.token.claims.role == 'admin';
    }

    // ============================================================================
    // DENY ALL BY DEFAULT
    // ============================================================================
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
